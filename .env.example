# Copy this file to .env, then fill in your own MySQL password.
# This is a template for others to read. NEVER commit .env to git.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change_me_to_your_mysql_password
DB_NAME=shortlink

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

BASE_URL=http://127.0.0.1:8000
CODE_LEN=6
URL_MAX_LEN=2048
